# ==============================================================================
# RadVision ACL — Git Ignore Configuration
# ==============================================================================

# --- Secrets and Credentials ---
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# --- Python Environments & Bytecode ---
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ipynb_checkpoints/
*.egg-info/
build/
dist/

# --- Model Weights & Checkpoints ---
*.pt
*.pth
*.ckpt
*.joblib
*.pkl
checkpoints/
knee_deploy/

# Allow specific trained deployment checkpoints
!acl_mri_classification/artifacts/deploy/resnet18.pt
!acl_mri_classification/artifacts/deploy/densenet121.pt
!acl_mri_classification/artifacts/deploy/efficientnet_b0.pt
!module1_baseline/artifacts/baseline_mlp.joblib
!module1_baseline/artifacts/baseline_logreg.joblib
!module4_sequence/artifacts/gru_checkpoint.pt

# --- Datasets & Temporary Uploads ---
*.pck
*.npy
data/KneeMRI/
data/
uploads/
radvision_uploads/
**/cache_*/
**/validation_trials_*/

# Allow small, essential benchmark evaluation metrics and partition splits
!acl_mri_classification/artifacts/splits.csv
!acl_mri_classification/artifacts/evaluation/test_metrics.json
!module1_baseline/artifacts/metrics.json
!module1_baseline/artifacts/eda.json

# --- Logs, OS & Editor Metadata ---
*.log
.DS_Store
Thumbs.db
.vscode/
.idea/
node_modules/
temp/
tmp/
screenshot_*.png
test_pacs_*.png
