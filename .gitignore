# ==============================================================================
# RadVision ACL — Git Ignore Configuration
# ==============================================================================

# --- Secrets and Credentials ---
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# --- Python Environments & Bytecode ---
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ipynb_checkpoints/
*.egg-info/
build/
dist/

# --- Large Model Checkpoints & Raw Data ---
# Heavy binary model weights
*.pt
*.pth
*.ckpt
*.joblib
*.pkl
checkpoints/
acl_mri_classification/artifacts/deploy/
acl_mri_classification/artifacts/model/
acl_mri_classification/artifacts/runs/
knee_deploy/

# Large MRI volumetric archives and raw files
*.pck
*.npy
data/KneeMRI/
data/
uploads/
radvision_uploads/
**/cache_*/
**/validation_trials_*/

# Allow small, essential benchmark evaluation metrics and partition splits
!acl_mri_classification/artifacts/splits.csv
!acl_mri_classification/artifacts/evaluation/test_metrics.json
!module1_baseline/artifacts/metrics.json
!module1_baseline/artifacts/eda.json

# --- Logs, OS & Editor Metadata ---
*.log
.DS_Store
Thumbs.db
.vscode/
.idea/
node_modules/
temp/
tmp/
screenshot_*.png
test_pacs_*.png
