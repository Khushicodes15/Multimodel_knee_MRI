# ==============================================================================
# RadVision ACL — Environment Configuration Template
# Copy this file to .env and configure your local settings.
# Do NOT commit .env with real credentials.
# ==============================================================================

# Deploy Checkpoints: comma-separated "name=path" or directory glob
# Default: searches acl_mri_classification/artifacts/deploy/*.pt
KNEE_MRI_CHECKPOINTS=resnet18=acl_mri_classification/artifacts/deploy/resnet18.pt,densenet121=acl_mri_classification/artifacts/deploy/densenet121.pt,efficientnet_b0=acl_mri_classification/artifacts/deploy/efficientnet_b0.pt

# Device setting: "cpu", "cuda", or leave blank for auto-detection
DEVICE=cpu

# Max upload size in megabytes (default 100)
MAX_UPLOAD_MB=100

# Report Generation Default Mode: "template" | "llm" (default: template)
REPORT_MODE_DEFAULT=template

# Google Gemini API Key (Required ONLY for LLM report mode)
# Obtain a key at: https://aistudio.google.com/
GEMINI_API_KEY=

# Gemini Model ID (e.g. gemini-2.5-flash or gemini-1.5-flash)
# See: https://ai.google.dev/gemini-api/docs/models/gemini
GEMINI_MODEL=gemini-2.5-flash

# LLM Timeout in seconds (default 30)
LLM_TIMEOUT_SECONDS=30
